generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROCURADOR
  ANUNCIANTE
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  password                String
  phone                   String?
  advertiserType          AdvertiserType?
  alternatePhone          String?
  contactChannels         ContactChannel[] @default([CHAT])
  photoUrl                String?
  photoKey                String?
  isProcurador            Boolean                  @default(true)
  isAnunciante            Boolean                  @default(false)
  isAdmin                 Boolean                  @default(false)
  auditLogs               AuditLog[]
  emailVerified           Boolean                  @default(false)
  emailVerifiedAt         DateTime?
  termsAcceptedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  listings                Listing[]
  favorites               Favorite[]
  unlocks                 Unlock[]
  chatsAsProcurador       Chat[]                   @relation("ChatsProcurador")
  chatsAsAnunciante       Chat[]                   @relation("ChatsAnunciante")
  messages                Message[]
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  notificationPreferences NotificationPreference[]
  reportsMade     Report[] @relation("ReportsMade")
  reportsResolved Report[] @relation("ReportsResolved")
  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  searchRequests SearchRequest[]
  identityVerifiedAt    DateTime?
  verifications         Verification[] @relation("UserVerifications")
  verificationsReviewed Verification[] @relation("VerificationsReviewed")
  referralCode      String?  @unique
  creditBalance     Decimal  @default(0) @db.Decimal(12, 2)
  referralsMade     Referral[] @relation("ReferralsMade")
  referralReceived  Referral?  @relation("ReferralReceived")
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  @@map("users")
}

enum ListingPurpose {
  ARRENDAR
  VENDER
  RESERVAR
}

enum ListingStatus {
  ACTIVO
  RESERVADO
  VENDIDO
  ARRENDADO
  EXPIRADO
  RASCUNHO
  SUSPENSO
  REMOVIDO
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  listings     Listing[]
  createdAt    DateTime      @default(now())
  pricingRules PricingRule[]
  searchRequests SearchRequest[]

  @@map("categories")
}

model Listing {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title       String
  purpose     ListingPurpose
  description String

  price       Decimal @db.Decimal(12, 2)
  pricePeriod String? // ex: "mensal" — só aplicável a arrendamento

  province                 String
  district                 String
  city                     String
  neighborhood             String
  latitude                 Float
  longitude                Float
  exactLocationAfterUnlock Boolean @default(true)

  bedrooms       Int?
  bathrooms      Int?
  area           Float?
  furnished      Boolean?
  hasWater       Boolean?
  hasElectricity Boolean?
  hasWifi        Boolean?
  hasParking     Boolean?

  conditions   String?
  availability String?

  status ListingStatus @default(RASCUNHO)

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  favorites    Favorite[]
  unlocks      Unlock[]
  media        Media[]
  publications ListingPublication[]
  reports      Report[]
  publishedAt  DateTime?
  expiresAt    DateTime?
  chats        Chat[]

  @@map("listings")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("favorites")
}

enum UnlockStatus {
  CONFIRMADO
  FALHOU
}

model Unlock {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  listingId        String
  listing          Listing      @relation(fields: [listingId], references: [id])
  amount           Decimal      @db.Decimal(10, 2)
  paymentReference String
  status           UnlockStatus
  createdAt        DateTime     @default(now())

  @@unique([userId, listingId])
  @@map("unlocks")
}

enum MediaType {
  IMAGEM
  VIDEO
}

model Media {
  id        String    @id @default(uuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  key       String
  order     Int       @default(0)
  size      Int
  createdAt DateTime  @default(now())

  @@map("media")
}

enum ChatStatus {
  ATIVO
  ARQUIVADO
  BLOQUEADO
  SUSPENSO
}

enum MessageType {
  TEXTO
  IMAGEM
  LOCALIZACAO
  LINK
}

model Chat {
  id           String     @id @default(uuid())
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id])
  procuradorId String
  procurador   User       @relation("ChatsProcurador", fields: [procuradorId], references: [id])
  anuncianteId String
  anunciante   User       @relation("ChatsAnunciante", fields: [anuncianteId], references: [id])
  status       ChatStatus @default(ATIVO)
  messages     Message[]
  createdAt    DateTime   @default(now())
  reviews   Review[]

  @@unique([listingId, procuradorId])
  @@map("chats")
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  chat      Chat        @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id])
  content   String
  type      MessageType @default(TEXTO)
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@map("messages")
}

enum NotificationType {
  DESBLOQUEIO_RECEBIDO
  NOVA_MENSAGEM
  SISTEMA
  NOVO_ANUNCIO_COMPATIVEL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())

  @@map("device_tokens")
}

model NotificationPreference {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  enabled Boolean          @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model PricingRule {
  id           String    @id @default(uuid())
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  city         String?
  amount       Decimal   @db.Decimal(12, 2)
  durationDays Int       @default(30)
  isActive     Boolean   @default(true)
  purpose  ListingPurpose?
  minPrice Decimal?        @db.Decimal(14, 2) // exclusivo: valor acima disto
  maxPrice Decimal?        @db.Decimal(14, 2) // inclusivo: até este valor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, city])
}

enum PublicationPaymentStatus {
  CONFIRMADO
  FALHOU
}

model ListingPublication {
  id               String                   @id @default(uuid())
  listingId        String
  listing          Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId           String
  pricingRuleId    String?
  promotionId      String?
  amount           Decimal                  @db.Decimal(12, 2)
  durationDays     Int
  paymentReference String
  status           PublicationPaymentStatus
  createdAt        DateTime                 @default(now())
  creditUsed       Decimal  @default(0) @db.Decimal(12, 2)

  @@index([listingId])
}

enum ReportReason {
  FRAUDE
  INFORMACAO_FALSA
  IMOVEL_INDISPONIVEL
  CONTEUDO_IMPROPRIO
  DUPLICADO
  OUTRO
}

enum ReportStatus {
  PENDENTE
  PROCEDENTE
  IMPROCEDENTE
}

model Report {
  id             String       @id @default(uuid())
  listingId      String
  listing        Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User         @relation("ReportsMade", fields: [reporterId], references: [id])
  reason         ReportReason
  details        String?
  status         ReportStatus @default(PENDENTE)
  resolvedById   String?
  resolvedBy     User?        @relation("ReportsResolved", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())

  @@unique([reporterId, listingId])
  @@index([status])
  @@map("reports")
}

model SearchRequest {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id])
  purpose    ListingPurpose?

  province String?
  district String?
  city     String?

  minPrice Decimal? @db.Decimal(12, 2)
  maxPrice Decimal? @db.Decimal(12, 2)
  bedrooms Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, city])
  @@map("search_requests")
}
model Review {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([chatId, authorId])
  @@index([targetId])
  @@map("reviews")
}

enum VerificationStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

model Verification {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  status          VerificationStatus @default(PENDENTE)
  note            String?
  reviewedById    String?
  reviewedBy      User?              @relation("VerificationsReviewed", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())

  @@index([userId, status])
  @@index([status])
  @@map("verifications")
}

model Promotion {
  id              String   @id @default(uuid())
  name            String
  city            String
  discountPercent Int      @default(50)
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city, isActive])
  @@map("promotions")
}

enum ReferralStatus {
  PENDENTE
  PAGO
}

model Referral {
  id          String         @id @default(uuid())
  referrerId  String
  referrer    User           @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredId  String         @unique
  referred    User           @relation("ReferralReceived", fields: [referredId], references: [id])
  status      ReferralStatus @default(PENDENTE)
  bonusAmount Decimal?       @db.Decimal(12, 2)
  paidAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([referrerId, status])
  @@map("referrals")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AdvertiserType {
  PROPRIETARIO
  AGENTE
  IMOBILIARIA
  ORGANIZACAO
}

enum ContactChannel {
  CHAT
  TELEFONE
  WHATSAPP
  EMAIL
}