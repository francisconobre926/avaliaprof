generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROCURADOR
  ANUNCIANTE
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  password                String
  phone                   String?
  isProcurador            Boolean                  @default(true)
  isAnunciante            Boolean                  @default(false)
  emailVerified           Boolean                  @default(false)
  emailVerifiedAt         DateTime?
  termsAcceptedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  listings                Listing[]
  favorites               Favorite[]
  unlocks                 Unlock[]
  chatsAsProcurador       Chat[]                   @relation("ChatsProcurador")
  chatsAsAnunciante       Chat[]                   @relation("ChatsAnunciante")
  messages                Message[]
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

enum ListingPurpose {
  ARRENDAR
  VENDER
  RESERVAR
}

enum ListingStatus {
  ACTIVO
  RESERVADO
  VENDIDO
  ARRENDADO
  EXPIRADO
  RASCUNHO
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  listings     Listing[]
  createdAt    DateTime      @default(now())
  pricingRules PricingRule[]

  @@map("categories")
}

model Listing {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title       String
  purpose     ListingPurpose
  description String

  price       Decimal @db.Decimal(12, 2)
  pricePeriod String? // ex: "mensal" — só aplicável a arrendamento

  province                 String
  district                 String
  city                     String
  neighborhood             String
  latitude                 Float
  longitude                Float
  exactLocationAfterUnlock Boolean @default(true)

  bedrooms       Int?
  bathrooms      Int?
  area           Float?
  furnished      Boolean?
  hasWater       Boolean?
  hasElectricity Boolean?
  hasWifi        Boolean?
  hasParking     Boolean?

  conditions   String?
  availability String?

  status ListingStatus @default(RASCUNHO)

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  favorites    Favorite[]
  unlocks      Unlock[]
  media        Media[]
  publications ListingPublication[]
  publishedAt  DateTime?
  expiresAt    DateTime?
  chats        Chat[]

  @@map("listings")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("favorites")
}

enum UnlockStatus {
  CONFIRMADO
  FALHOU
}

model Unlock {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  listingId        String
  listing          Listing      @relation(fields: [listingId], references: [id])
  amount           Decimal      @db.Decimal(10, 2)
  paymentReference String
  status           UnlockStatus
  createdAt        DateTime     @default(now())

  @@unique([userId, listingId])
  @@map("unlocks")
}

enum MediaType {
  IMAGEM
  VIDEO
}

model Media {
  id        String    @id @default(uuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  key       String
  order     Int       @default(0)
  size      Int
  createdAt DateTime  @default(now())

  @@map("media")
}

enum ChatStatus {
  ATIVO
  ARQUIVADO
  BLOQUEADO
  SUSPENSO
}

enum MessageType {
  TEXTO
  IMAGEM
  LOCALIZACAO
  LINK
}

model Chat {
  id           String     @id @default(uuid())
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id])
  procuradorId String
  procurador   User       @relation("ChatsProcurador", fields: [procuradorId], references: [id])
  anuncianteId String
  anunciante   User       @relation("ChatsAnunciante", fields: [anuncianteId], references: [id])
  status       ChatStatus @default(ATIVO)
  messages     Message[]
  createdAt    DateTime   @default(now())

  @@unique([listingId, procuradorId])
  @@map("chats")
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  chat      Chat        @relation(fields: [chatId], references: [id])
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id])
  content   String
  type      MessageType @default(TEXTO)
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@map("messages")
}

enum NotificationType {
  DESBLOQUEIO_RECEBIDO
  NOVA_MENSAGEM
  SISTEMA
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())

  @@map("device_tokens")
}

model NotificationPreference {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  enabled Boolean          @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model PricingRule {
  id           String    @id @default(uuid())
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  city         String?
  amount       Decimal   @db.Decimal(12, 2)
  durationDays Int       @default(30)
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, city])
}

enum PublicationPaymentStatus {
  CONFIRMADO
  FALHOU
}

model ListingPublication {
  id               String                   @id @default(uuid())
  listingId        String
  listing          Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId           String
  pricingRuleId    String?
  amount           Decimal                  @db.Decimal(12, 2)
  durationDays     Int
  paymentReference String
  status           PublicationPaymentStatus
  createdAt        DateTime                 @default(now())

  @@index([listingId])
}