# ───────── Servidor ─────────
PORT=3002
NODE_ENV=development

# ───────── Base de dados (PostgreSQL via docker compose) ─────────
# docker compose up -d  cria o Postgres em localhost:5434
# Gera a password com: openssl rand -hex 16  (sem @ : / ? #)
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://avaliaprof:<POSTGRES_PASSWORD>@localhost:5434/avaliaprof?schema=public"

# ───────── Segredo do JWT (obrigatório, mínimo 32 caracteres) ─────────
# Gera com: openssl rand -hex 32
JWT_SECRET=

# ───────── CORS ─────────
# Origens de browser autorizadas, separadas por vírgulas. Vazio = nenhuma (a app móvel não precisa).
CORS_ORIGINS=

# ───────── Swagger (/docs): por defeito só fora de produção ─────────
SWAGGER_ENABLED=

# ───────── Seed (npx prisma db seed) ─────────
# Cria o administrador. A password deve ter pelo menos 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# false = não cria o catálogo de exemplo (usar quando houver dados reais)
SEED_DEV_CATALOG=true

# ───────── Limites de pedidos por minuto (os valores por defeito são os seguros) ─────────
# RATE_LIMIT=100
# AUTH_RATE_LIMIT=10
# Nº mínimo de avaliações para mostrar médias (anonimato)
# MIN_SAMPLE=5

# ───────── Produção (Render, ver docs/DEPLOY_RENDER.md) ─────────
# Nº de proxies à frente da API (Render = 1). Em desenvolvimento deixar vazio.
# TRUST_PROXY=1
# Duração do token de acesso (por defeito 30m)
# ACCESS_TOKEN_TTL=30m
# false = desliga a tarefa periódica dos avisos de períodos
# NOTIFICATIONS_JOB=true
