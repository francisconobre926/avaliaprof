{
  "expo": {
    "name": "AvaliaProf",
    "slug": "avaliaprof",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#6AA6DA"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.avaliaprof"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "avaliaprof",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6AA6DA"
        }
      ],
      "expo-image",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A AvaliaProf precisa de aceder às tuas fotos para definires a fotografia de perfil.",
          "cameraPermission": "A AvaliaProf precisa da câmara para tirares a fotografia de perfil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A AvaliaProf precisa da câmara para ler o QR Code do docente ou da aula."
        }
      ],
      "expo-sqlite",
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
