# ───────── Servidor ─────────
PORT=3000
NODE_ENV=development

# ───────── Base de dados (PostgreSQL) ─────────
# A password NÃO pode ter @ : / ? #. Gera uma com: openssl rand -hex 16
DATABASE_URL="postgresql://gohome:TROCAR_PASSWORD@localhost:5432/gohome?schema=public"

# ───────── Segredos (obrigatórios, mínimo 32 caracteres) ─────────
# Gera cada um com: openssl rand -hex 32
JWT_SECRET=
LOCATION_SECRET=

# ───────── CORS ─────────
# Origens de navegador autorizadas, separadas por vírgulas (ex.: o painel de admin).
# Vazio = nenhuma. A app móvel não passa pelo CORS.
CORS_ORIGINS=

# ───────── Documentação (Swagger em /docs) ─────────
# Por defeito só liga fora de produção. true/false força o valor.
SWAGGER_ENABLED=true

# ───────── Armazenamento de ficheiros (Cloudflare R2) ─────────
R2_ENDPOINT=https://O_TEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Endereço público do bucket, sem barra no fim
R2_PUBLIC_URL=

# ───────── Notificações push (Firebase) ─────────
# Caminho para o ficheiro de credenciais. Esse ficheiro NUNCA vai para o Git.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json